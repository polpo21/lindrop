+void awdl_set_addba_accept(int on) {
+	addba_accept = on;
+}
+
+/* Answer an ADDBA request (Block Ack setup) addressed to us. Unanswered, an
+ * iPhone asks again and again and sends every frame on its own; the Block
+ * Acks themselves come from the hardware, which owns our MAC. */
+static void awdl_addba_reply(struct daemon_state *state, const uint8_t *buf, uint32_t len) {
+	const struct ether_addr *self = &state->awdl_state.self_address;
+	uint8_t out[128], *ptr = out;
+	uint16_t rtlen, req, timeout, params, bufsize;
+	const uint8_t *h, *b;
+
+	if (len < 4)
+		return;
+	rtlen = buf[2] | (buf[3] << 8);
+	if (len < (uint32_t) rtlen + 24 + 9)
+		return;
+	h = buf + rtlen;
+	b = h + 24;
+	/* management/action, to us, category 3 (Block Ack), action 0 (ADDBA request) */
+	if (h[0] != 0xd0 || memcmp(h + 4, self, 6) || b[0] != 3 || b[1] != 0)
+		return;
+	req = b[3] | (b[4] << 8);
+	timeout = b[5] | (b[6] << 8);
+	bufsize = req >> 6;
+	if (bufsize == 0 || bufsize > 64)
+		bufsize = 64;
+	/* no A-MSDU, immediate Block Ack, the TID asked for, our buffer size */
+	params = 0x0002 | (req & 0x003c) | (bufsize << 6);
+
+	ptr += ieee80211_init_radiotap_header(ptr);
+	ptr += ieee80211_init_awdl_action_hdr(ptr, self, (const struct ether_addr *) (h + 10), &state->ieee80211_state);
+	*ptr++ = 3;                /* category: Block Ack */
+	*ptr++ = 1;                /* action: ADDBA response */
+	*ptr++ = b[2];             /* dialog token */
+	*ptr++ = 0; *ptr++ = 0;    /* status: success */
+	*ptr++ = params & 0xff; *ptr++ = params >> 8;
+	*ptr++ = timeout & 0xff; *ptr++ = timeout >> 8;
+	if (state->ieee80211_state.fcs)
+		ptr += ieee80211_add_fcs(out, ptr);
+	if (wlan_send(&state->io, out, ptr - out) >= 0)
+		log_debug("ADDBA accepted from %s (tid %d, buffer %d)", ether_ntoa((const struct ether_addr *) (h + 10)),
+		          (req >> 2) & 0xf, bufsize);
+}
