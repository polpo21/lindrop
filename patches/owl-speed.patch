+/* PHY rate of data frames (-R): legacy Mbit/s, or HT MCS when data_mcs >= 0.
+ * Action frames always go at legacy 12, as iPhones send theirs. */
+static int data_rate = 12;
+static int data_mcs = -1;
+static int data_sgi;
+
+int ieee80211_set_data_rate(const char *spec) {
+	char *end;
+	long v;
+
+	if (!strncmp(spec, "mcs", 3)) {
+		v = strtol(spec + 3, &end, 10);
+		if (end == spec + 3 || v < 0 || v > 15)
+			return -1;
+		if (*end && strcmp(end, "-sgi"))
+			return -1;
+		data_mcs = (int) v;
+		data_sgi = *end != 0;
+		return 0;
+	}
+	v = strtol(spec, &end, 10);
+	if (*end)
+		return -1;
+	switch (v) {
+		case 6: case 9: case 12: case 18: case 24: case 36: case 48: case 54:
+			data_rate = (int) v;
+			data_mcs = -1;
+			return 0;
+		default:
+			return -1;
+	}
+}
+
+static int ieee80211_init_radiotap_data_header(uint8_t *buf) {
+	struct ieee80211_radiotap_header *hdr = (struct ieee80211_radiotap_header *) buf;
+	uint8_t *ptr = buf + sizeof(struct ieee80211_radiotap_header);
+	uint32_t present = 0;
+
+	if (data_mcs < 0) {
+		int len = ieee80211_init_radiotap_header(buf);
+		if (data_rate != 12)
+			buf[len - 1] = ieee80211_radiotap_rate_to_val(data_rate);
+		return len;
+	}
+
+	hdr->it_version = 0;
+	hdr->it_pad = 0;
+	present |= ieee80211_radiotap_type_to_mask(IEEE80211_RADIOTAP_MCS);
+	ptr[0] = IEEE80211_RADIOTAP_MCS_HAVE_BW | IEEE80211_RADIOTAP_MCS_HAVE_MCS | IEEE80211_RADIOTAP_MCS_HAVE_GI;
+	ptr[1] = IEEE80211_RADIOTAP_MCS_BW_20 | (data_sgi ? IEEE80211_RADIOTAP_MCS_SGI : 0);
+	ptr[2] = (uint8_t) data_mcs;
+	ptr += 3;
+
+	hdr->it_len = htole16((uint16_t) (ptr - buf));
+	hdr->it_present = htole32(present);
+
+	return ptr - buf;
+}
